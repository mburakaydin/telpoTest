<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/titleTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/screen_title"
            android:textColor="#1F2937"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/statusTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#EEF2FF"
            android:padding="12dp"
            android:text="@string/status_initializing"
            android:textColor="#1F2937"
            android:textSize="16sp" />

        <Button
            android:id="@+id/pollButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/button_poll_card" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/label_block"
            android:textColor="#374151"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/blockEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/default_mifare_block"
            android:inputType="number"
            android:maxLines="1"
            android:text="@string/default_mifare_block" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/label_key"
            android:textColor="#374151"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/keyEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/default_mifare_key"
            android:inputType="textCapCharacters|textNoSuggestions"
            android:maxLines="1"
            android:text="@string/default_mifare_key" />

        <Switch
            android:id="@+id/keyTypeSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/switch_use_key_b" />

        <Button
            android:id="@+id/authenticateButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/button_authenticate" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/label_read_write_data"
            android:textColor="#374151"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/dataEditText"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:gravity="top|start"
            android:hint="@string/hint_read_write_data"
            android:inputType="textMultiLine|textCapCharacters|textNoSuggestions"
            android:minLines="5"
            android:padding="12dp" />

        <Button
            android:id="@+id/readButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/button_read" />

        <Button
            android:id="@+id/writeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/button_write" />

    </LinearLayout>
</ScrollView>
